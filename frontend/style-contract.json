{
  "convention": "none",
  "exclude": [],
  "include": [],
  "tsconfig": "./tsconfig.json",
  "rules": {
    "naming-convention-global": "off",
    "no-dynamic-references": "off",
    "unused-dependent-class": "off",
    "unused-export": "off",
    "unused-class": "off",
    "leaked-class-usage": "warning",
    "class-leak": "warning",
    "empty-rule": "off"
  }
}
