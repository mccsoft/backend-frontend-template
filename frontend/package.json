  "scripts": {
    "start": "yarn prestart && concurrently \"vite\" \"yarn css-to-types -w\"",
    "start-remote": "yarn prestart && concurrently \"BACKEND_URI=https://template.mcc-soft.de vite\" \"yarn css-to-types -w\"",
    "prestart": "yarn build-css-for-razor",
    "typecheck": "yarn css-to-types && tsc && eslint \\*\\*/\\*.ts \\*\\*/\\*.tsx --quiet",
    "css-to-types": "tcm -p 'src/**/*.css' . -c dashes",
    "test": "vitest",
    "figma-icons": "echo 'Open AI Chat and paste the following prompt: \"Run exact instructions from `frontend/src/assets/icons-figma/PROMPT.md`\". After it completes press Enter to continue' && node -e \"process.stdin.once('data', () => process.exit(0))\" && yarn figma-snapshot-to-tokens && yarn figma-tokens-to-css",
    "figma-to-code": "echo 'Open AI Chat and paste the following prompt: \"Run exact instructions from `frontend/src/styles/figma/PROMPT.md`\". After it completes press Enter to continue' && node -e \"process.stdin.once('data', () => process.exit(0))\" && yarn figma-snapshot-to-css",
    "figma-snapshot-to-css": "yarn figma-snapshot-to-tokens && yarn figma-tokens-to-css",
    "figma-snapshot-to-tokens": "npx tokens-bruecke --input src/styles/figma/snapshot.json --output src/styles/figma/tokens.json -c src/styles/figma/tokens-bruecke.config.json",
    "figma-tokens-to-css": "node src/styles/figma/style-dictionary.js",
    "build": "cross-env NODE_OPTIONS=\"--max-old-space-size=7000\" vite build && yarn build-css-for-razor",
    "build-css-for-razor": "npx concat-cli -f src/styles/variables.css src/styles/z-index.css src/styles/base.css src/index.css src/components/uikit/Field.module.css src/components/uikit/inputs/Input.module.css src/components/uikit/buttons/Button.module.css src/razor.css -o ../webapi/src/MccSoft.TemplateApp.App/wwwroot/css/frontend.css",
    "preview": "TST=321 npx import-meta-env -x .env && vite preview",
    "preview-remote": "TST=321 npx import-meta-env -x .env && BACKEND_URI=https://template.mcc-soft.de vite preview",
    "generate-api-clients": "concurrently \"yarn generate-api-client-axios\" \"yarn generate-api-client-dotnet\"",
    "generate-api-client-axios": "react-query-swagger openapi2tsclient /tanstack /input:https://localhost:5001/swagger/v1/swagger.json /output:src/services/api/api-client.ts /template:Axios /serviceHost:. /minimal",
    "generate-api-client-remote": "react-query-swagger openapi2tsclient /tanstack /input:https://template.mcc-soft.de/swagger/v1/swagger.json /output:src/services/api/api-client.ts /template:Axios /serviceHost:. /minimal",
    "generate-api-client-dotnet": "react-query-swagger openapi2csclient /nswag /input:https://localhost:5001/swagger/csharp/swagger.json /output:../webapi/src/MccSoft.TemplateApp.Http/GeneratedClient.cs /templateDirectory:../webapi/src/MccSoft.TemplateApp.Http/template /namespace:MccSoft.TemplateApp.Http.Generated /generateClientInterfaces:true /clientBaseClass:BaseClient /exposeJsonSerializerSettings:true /generateUpdateJsonSerializerSettingsMethod:false /clientBaseInterface:IBaseClient /jsonLibrary:SystemTextJson && yarn replace \", NullValueHandling = Newtonsoft.Json.NullValueHandling.Ignore\" \" \" ../webapi/src/MccSoft.TemplateApp.Http/GeneratedClient.cs",
    "npm-start": "yarn start",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "proxy": "http://localhost:48728"
}
